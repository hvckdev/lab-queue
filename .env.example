# Optional: docker compose up --build works without an .env file.
# Create the first administrator and choose its password in the browser.
# User passwords are stored only as bcrypt hashes; no default admin password.
POSTGRES_PASSWORD=postgres_demo_password
ACCOUNTS_DB_PASSWORD=accounts_demo_password
QUEUE_DB_PASSWORD=queue_demo_password
JWT_SECRET=labqueue-demo-secret-change-before-publishing-2026
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
